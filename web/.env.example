VITE_DEV_USERNAME=operator
VITE_DEV_PASSWORD=changeme

# mock = in-browser simulated drone (resets on every reload).
# ws = standalone mock-agent process (../mock-agent) — state survives reloads.
# webrtc = the real agent (../agent) over WebRTC, via the signalling server (../server).
VITE_VEHICLE_LINK=mock
VITE_WS_URL=ws://localhost:8787

# webrtc only. ICE URLs are comma-separated STUN/TURN URLs.
VITE_SIGNAL_URL=ws://localhost:8788/signal
VITE_ICE_URLS=stun:stun.l.google.com:19302
# true = force every path through TURN, to test the relayed path.
VITE_ICE_RELAY_ONLY=false

# Optional: enables 3D building extrusion on the flight map's satellite view.
# Free tier at https://cloud.maptiler.com/account/keys/ — map works fine without it.
VITE_MAPTILER_KEY=
