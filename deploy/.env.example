# Copy to .env (gitignored) next to docker-compose.yml.

# The public name Caddy gets a certificate for (its DNS must point here).
# `localhost` gives a local self-signed certificate, for trying it out.
DOMAIN=fly.example.com
# First start only: the admin account. Change the password after, or remove
# these once it exists (they never overwrite an existing account).
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
# Host ports, if 80/443 are taken (e.g. trying it on a laptop).
HTTP_PORT=80
HTTPS_PORT=443
