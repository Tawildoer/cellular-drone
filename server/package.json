{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Auth, missions and the signalling relay between the browser and the drone agent (Phase 1c): Fastify on Node 24, SQLite through node:sqlite, argon2id through node:crypto.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cellular-drone/protocol": "file:../packages/protocol",
    "@fastify/cookie": "^11.1.3",
    "fastify": "^5.12.5",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.13",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24.7"
  }
}
