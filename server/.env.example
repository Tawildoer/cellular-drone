# Copy to .env (gitignored). npm run dev / start / cli read it.

HOST=0.0.0.0
PORT=8788
# SQLite database: users, sessions, missions.
DB_PATH=data/server.db

# First start only: creates this admin if no user has the name. Add more
# users with `npm run cli -- user:add <name>`.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secure session cookie. Browsers accept Secure cookies on http://localhost,
# so this stays true even in development; false only for plain http on
# another host (a LAN address), never in production.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
# The key that signs session tokens for the drones, created on first start.
# Its public half (npm run cli -- keys:show) is every agent's -server-pubkey.
SESSION_SIGNING_KEY_FILE=data/session-signing.key
SESSION_TOKEN_TTL_S=60
# Flight logs the drones upload, one directory per vehicle.
FLIGHT_LOG_DIR=data/flightlogs
# Extra origins allowed to send the cookie (comma-separated), e.g. the Vite
# dev server when it isn't proxying: http://localhost:5173. Same host is
# always allowed.
ALLOWED_ORIGINS=
# true behind Caddy, so rate limits see the client's address.
TRUST_PROXY=false
